# ───────────── Dependencies ─────────────
node_modules/
.pnp
.pnp.*
.yarn/
.pnpm-store/

# ───────────── Build output ─────────────
dist/
build/
out/
web/dist/
*.tsbuildinfo
.vite/
.cache/
.parcel-cache/

# ───────────── Environment & secrets ─────────────
# Never commit real configuration. Document variables in the README instead.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
secrets/
.npmrc

# ───────────── ngrok / tunnels ─────────────
# The ngrok authtoken lives in ngrok.yml; keep it out of the repo.
ngrok.yml
ngrok.yaml
.ngrok/
ngrok*.log

# ───────────── Logs ─────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ───────────── Test, coverage & generated artifacts ─────────────
coverage/
.nyc_output/
html/
test-results/
playwright-report/
playwright/.cache/
vitest-report*/
*.junit.xml
# Generated by `npm run visual-check` (curated screenshots live in docs/screenshots/)
.visual/
# Match replay logs written when REPLAY_DIR is set (<seriesId>.replay.json)
replays/
*.replay.json

# ───────────── OS junk ─────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ───────────── Editors & IDEs ─────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ───────────── AI tooling (local state and session transcripts) ─────────────
# Session transcripts contain local machine paths and the full prompt history.
.claude/
.cc-history/
CLAUDE.local.md

# ───────────── Scratch ─────────────
tmp/
temp/
tmp-*
*.tmp
*.bak
