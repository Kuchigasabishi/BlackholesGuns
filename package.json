{
  "name": "blackholes-and-guns",
  "version": "1.0.4",
  "private": true,
  "description": "Blackholes & Guns: deterministic server-side game engine (GDD v1.0.4)",
  "type": "module",
  "scripts": {
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "build": "npm run typecheck && npm run build:web",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "start": "node ./node_modules/tsx/dist/cli.mjs ./src/main.ts",
    "dev:web": "node ./node_modules/vite/bin/vite.js --config web/vite.config.ts",
    "build:web": "node ./node_modules/vite/bin/vite.js build --config web/vite.config.ts",
    "start:tunnel": "node ./node_modules/tsx/dist/cli.mjs ./src/tunnel.ts",
    "dev:server": "node ./node_modules/tsx/dist/cli.mjs ./src/main.ts",
    "visual-check": "node ./node_modules/tsx/dist/cli.mjs ./scripts/visual-check.ts",
    "generate:sounds": "node ./node_modules/tsx/dist/cli.mjs ./scripts/generate-sounds.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.0",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=22"
  }
}
